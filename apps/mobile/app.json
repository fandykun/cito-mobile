{
  "expo": {
    "name": "Cito Petcare",
    "slug": "cito-petcare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citopetcare",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.citopetcare.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.citopetcare.app",
      "adaptiveIcon": {
        "backgroundColor": "#F9F9F9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F9F9"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a19df58-732e-49f8-b24e-fb486082c9c2"
      }
    },
    "owner": "fandykunnns-team"
  }
}
